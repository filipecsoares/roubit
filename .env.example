# Roubit Environment Configuration Example
# Copy to .env to customize local development or production variables

# --- Mode 1: Local Development (Default — SQLite in WAL mode, zero external dependencies) ---
DATABASE_URL=sqlite://roubit.db?mode=rwc

# --- Mode 2: Production & Integration Testing (PostgreSQL 16 + Redis 7) ---
# DATABASE_URL=postgres://roubit_user:roubit_secure_password@localhost:5432/roubit
# REDIS_URL=redis://127.0.0.1:6379

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
JWT_SECRET=change_me_in_production_at_least_32_characters_long!
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RUST_LOG=roubit=debug,tower_http=debug
